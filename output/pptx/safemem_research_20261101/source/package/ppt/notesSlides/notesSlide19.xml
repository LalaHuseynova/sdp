hed. Active policy paths use the shared refill rule. Unsupported modes are rejected. No private labels, hidden profiles or policy traces are appended to answering prompts.</a:t></a:r><a:endParaRPr lang="en-US" sz="1200"/></a:p><a:p><a:pPr algn="l"><a:lnSpc><a:spcPct val="105000"/></a:lnSpc><a:spcAft><a:spcPts val="300"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1200" b="0" i="0"><a:solidFill><a:srgbClr val="222B31"/></a:solidFill><a:latin typeface="Arial"/><a:ea typeface="Arial"/><a:cs typeface="Arial"/></a:rPr><a:t xml:space="preserve"></a:t></a:r><a:endParaRPr lang="en-US" sz="1200"/></a:p><a:p><a:pPr algn="l"><a:lnSpc><a:spcPct val="105000"/></a:lnSpc><a:spcAft><a:spcPts val="300"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1200" b="0" i="0"><a:solidFill><a:srgbClr val="222B31"/></a:solidFill><a:latin typeface="Arial"/><a:ea typeface="Arial"/><a:cs typeface="Arial"/></a:rPr><a:t xml:space="preserve">SOURCES</a:t></a:r><a:endParaRPr lang="en-US" sz="1200"/></a:p><a:p><a:pPr algn="l"><a:lnSpc><a:spcPct val="105000"/></a:lnSpc><a:spcAft><a:spcPts val="300"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1200" b="0" i="0"><a:solidFill><a:srgbClr val="222B31"/></a:solidFill><a:latin typeface="Arial"/><a:ea typeface="Arial"/><a:cs typeface="Arial"/></a:rPr><a:t xml:space="preserve">- src/ams/research/retrieval/adapter.py</a:t></a:r><a:endParaRPr lang="en-US" sz="1200"/></a:p><a:p><a:pPr algn="l"><a:lnSpc><a:spcPct val="105000"/></a:lnSpc><a:spcAft><a:spcPts val="300"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1200" b="0" i="0"><a:solidFill><a:srgbClr val="222B31"/></a:solidFill><a:latin typeface="Arial"/><a:ea typeface="Arial"/><a:cs typeface="Arial"/></a:rPr><a:t xml:space="preserve">- src/ams/research/retrieval/metadata.py</a:t></a:r><a:endParaRPr lang="en-US" sz="1200"/></a:p><a:p><a:pPr algn="l"><a:lnSpc><a:spcPct val="105000"/></a:lnSpc><a:spcAft><a:spcPts val="300"/></a:spcAft><a:buNone/></a:pPr><a:r><