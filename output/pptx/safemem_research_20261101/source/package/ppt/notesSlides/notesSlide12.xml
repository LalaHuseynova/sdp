a overlay. Public object allowlists exclude Y_case, expected_memory, h/z profiles, scenario labels and unrevealed audit results.</a:t></a:r><a:endParaRPr lang="en-US" sz="1200"/></a:p><a:p><a:pPr algn="l"><a:lnSpc><a:spcPct val="105000"/></a:lnSpc><a:spcAft><a:spcPts val="300"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1200" b="0" i="0"><a:solidFill><a:srgbClr val="222B31"/></a:solidFill><a:latin typeface="Arial"/><a:ea typeface="Arial"/><a:cs typeface="Arial"/></a:rPr><a:t xml:space="preserve"></a:t></a:r><a:endParaRPr lang="en-US" sz="1200"/></a:p><a:p><a:pPr algn="l"><a:lnSpc><a:spcPct val="105000"/></a:lnSpc><a:spcAft><a:spcPts val="300"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1200" b="0" i="0"><a:solidFill><a:srgbClr val="222B31"/></a:solidFill><a:latin typeface="Arial"/><a:ea typeface="Arial"/><a:cs typeface="Arial"/></a:rPr><a:t xml:space="preserve">SOURCES</a:t></a:r><a:endParaRPr lang="en-US" sz="1200"/></a:p><a:p><a:pPr algn="l"><a:lnSpc><a:spcPct val="105000"/></a:lnSpc><a:spcAft><a:spcPts val="300"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1200" b="0" i="0"><a:solidFill><a:srgbClr val="222B31"/></a:solidFill><a:latin typeface="Arial"/><a:ea typeface="Arial"/><a:cs typeface="Arial"/></a:rPr><a:t xml:space="preserve">- src/ams/research/provisional/episodes.py</a:t></a:r><a:endParaRPr lang="en-US" sz="1200"/></a:p><a:p><a:pPr algn="l"><a:lnSpc><a:spcPct val="105000"/></a:lnSpc><a:spcAft><a:spcPts val="300"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1200" b="0" i="0"><a:solidFill><a:srgbClr val="222B31"/></a:solidFill><a:latin typeface="Arial"/><a:ea typeface="Arial"/><a:cs typeface="Arial"/></a:rPr><a:t xml:space="preserve">- src/ams/research/phase1_scenarios.py</a:t></a:r><a:endParaRPr lang="en-US" sz="1200"/></a:p><a:p><a:pPr algn="l"><a:lnSpc><a:spcPct val="105000"/></a:lnSpc><a:spcAft><a:spcPts val="300"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1200" b="0" i="0"><